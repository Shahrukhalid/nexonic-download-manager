"Tries per part before a download stops: %lld" = "چۈشۈرۈشنى توختىتىشتىن بۇرۇن ھەر بىر قىسمىنى سىناش: %lld";
"Reconnect a part that receives nothing for %lld s" = "%lld ئۈچۈن ھېچ نەرسىنى قوبۇل قىلمىغان قىسمىنى قايتا باغلاش";
