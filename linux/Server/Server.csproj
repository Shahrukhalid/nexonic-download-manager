<Project Sdk="Microsoft.NET.Sdk">
  <!-- Nexonic Download Manager without a window, for servers, NAS boxes and Docker: managed from a phone or browser
       (remote access) and the local API. Uses the same download core as the desktop apps. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>nexonic-server</AssemblyName>
    <RootNamespace>Nexonic.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Desktop\Desktop.csproj" />
  </ItemGroup>
</Project>
