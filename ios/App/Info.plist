			<array>
				<string>nexonic</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Magnet link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>magnet</string>
			</array>
		</dict>
	</array>
