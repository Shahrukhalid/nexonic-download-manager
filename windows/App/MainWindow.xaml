<Window x:Class="Nexonic.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nexonic.App"
        Title="Nexonic Download Manager" Width="1100" Height="620" MinWidth="760" MinHeight="420"
        AllowDrop="True" Drop="OnDrop" Background="#F7F9FC">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#1F6FEB" />
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinWidth" Value="66" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#1F2328" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#EAF1FD" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#D6E4FB" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F6F8FA" />
      <Setter Property="Foreground" Value="#57606A" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="#E3E8EF" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="White" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F7FE" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCE8FC" /><Setter Property="Foreground" Value="#1F2328" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="6,4">
      <WrapPanel>
        <Button Style="{StaticResource ToolButton}" Click="OnAdd" ToolTip="Add one or more links (Ctrl+N)">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" /><TextBlock Style="{StaticResource Caption}" Text="Add URL" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnResume" ToolTip="Resume the selected downloads">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" /><TextBlock Style="{StaticResource Caption}" Text="Resume" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnPause" ToolTip="Stop the selected downloads">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" /><TextBlock Style="{StaticResource Caption}" Text="Stop" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnPauseAll" ToolTip="Stop every download">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" /><TextBlock Style="{StaticResource Caption}" Text="Stop All" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnSelectAll" ToolTip="Select every download in this list (click again to deselect)">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE762;" /><TextBlock Style="{StaticResource Caption}" Text="Select All" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnRemove" ToolTip="Remove the selected downloads from the list">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" /><TextBlock Style="{StaticResource Caption}" Text="Delete" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnClear" ToolTip="Remove finished downloads from the list">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" /><TextBlock Style="{StaticResource Caption}" Text="Delete Completed" /></StackPanel>
        </Button>
        <Separator Margin="6,4" />
        <Button Style="{StaticResource ToolButton}" Click="OnScheduler" ToolTip="Queues and timetables">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE787;" /><TextBlock Style="{StaticResource Caption}" Text="Scheduler" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnStartQueue" ToolTip="Start the selected queue">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" /><TextBlock Style="{StaticResource Caption}" Text="Start Queue" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnStopQueue" ToolTip="Stop the selected queue">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" /><TextBlock Style="{StaticResource Caption}" Text="Stop Queue" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnGrabber" ToolTip="Download files from a website section">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" /><TextBlock Style="{StaticResource Caption}" Text="Grabber" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnBatch" ToolTip="Download a numbered series of files">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" /><TextBlock Style="{StaticResource Caption}" Text="Batch" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnSettings" ToolTip="Options">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" /><TextBlock Style="{StaticResource Caption}" Text="Options" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnHelp" ToolTip="Help (F1)">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE897;" /><TextBlock Style="{StaticResource Caption}" Text="Help" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnAbout" ToolTip="About Nexonic Download Manager">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" /><TextBlock Style="{StaticResource Caption}" Text="About" /></StackPanel>
        </Button>
        <Border Margin="12,6,4,6" Width="220" Height="30" CornerRadius="6" BorderBrush="#D0D7DE" BorderThickness="1" Background="White" VerticalAlignment="Center">
          <Grid>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#8B949E" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBox x:Name="Search" BorderThickness="0" Background="Transparent" Margin="28,0,6,0" VerticalContentAlignment="Center" TextChanged="OnSearch" ToolTip="Search downloads (Ctrl+F)" />
            <TextBlock x:Name="SearchHint" Text="Search downloads" Foreground="#8B949E" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
        </Border>
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#F6F8FA" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="#57606A" FontSize="11" />
        <TextBlock x:Name="StatusLeft" Foreground="#57606A" FontSize="11" />
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" MinWidth="150" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="Sidebar" Grid.Column="0" BorderThickness="0" Background="#EEF2F7" SelectionChanged="OnFilter" Padding="0,6" />
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E3E8EF" />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                  MouseDoubleClick="OnOpen" SelectionChanged="OnSelection" Background="White"
                  BorderThickness="0" RowHeight="30" CanUserReorderColumns="True" CanUserSortColumns="True"
                  HorizontalGridLinesBrush="#EEF1F4" GridLinesVisibility="Horizontal">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="OnOpen" />
              <MenuItem Header="Show in Folder" Click="OnShowInFolder" />
              <MenuItem Header="Show Progress" Click="OnShowProgress" />
              <Separator />
              <MenuItem Header="Resume" Click="OnResume" />
              <MenuItem Header="Stop" Click="OnPause" />
              <MenuItem Header="Refresh Link…" Click="OnRefreshLink" />
              <MenuItem Header="Properties…" Click="OnProperties" />
              <MenuItem Header="Copy Link" Click="OnCopyLink" />
              <MenuItem Header="Show QR Code…" Click="OnShowQr" />
              <MenuItem x:Name="MoveMenu" Header="Move to Queue" />
              <Separator />
              <MenuItem Header="Delete…" Click="OnRemove" />
              <MenuItem Header="Delete and Move File to Recycle Bin…" Click="OnRemoveFile" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="File Name" Width="*" MinWidth="230" SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon, Mode=OneWay}" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
            <DataGridTemplateColumn Header="Progress" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="10" Margin="4,0" Foreground="{StaticResource Accent}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="80" />
            <DataGridTextColumn Header="Time Left" Binding="{Binding TimeLeft}" Width="70" />
            <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="Status">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush, Mode=OneWay}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status, Mode=OneWay}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Queue" Binding="{Binding Queue}" Width="90" />
            <DataGridTextColumn Header="Added" Binding="{Binding Added}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="Empty" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="400">
          <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="52" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyTitle" Text="No downloads here yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,6" />
          <TextBlock Text="Click Add URL, paste a link, drop one on this window, or download from your browser with the extension." TextWrapping="Wrap" TextAlignment="Center" Foreground="#57606A" />
          <Button Content="Add URL" Click="OnAdd" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="18,6" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
        <Border x:Name="Details" Grid.Row="1" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="12,8" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="DetailName" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
            <TextBox x:Name="DetailUrl" IsReadOnly="True" BorderThickness="0" Foreground="Gray" FontSize="11" Background="Transparent" />
            <local:SegmentBar x:Name="Bar" Height="14" Margin="0,6" />
            <TextBlock x:Name="DetailInfo" FontSize="11" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailError" FontSize="11" Foreground="#CF222E" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
