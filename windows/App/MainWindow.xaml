<Window x:Class="Nexonic.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nexonic.App"
        Title="Nexonic Download Manager" Width="1100" Height="620" MinWidth="760" MinHeight="420"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Background="{DynamicResource Win.Back}">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#1F6FEB" />
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinWidth" Value="66" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Win.Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Win.Hover}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Win.Pressed}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Win.Header}" />
      <Setter Property="Foreground" Value="{DynamicResource Win.Muted}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="{DynamicResource Win.Line}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{DynamicResource Win.Panel}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Win.RowHover}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Win.Selected}" /><Setter Property="Foreground" Value="{DynamicResource Win.Text}" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{DynamicResource Win.Panel}" Padding="4,2">
      <MenuItem Header="_Tasks">
        <MenuItem Header="_Add URL…" InputGestureText="Ctrl+N" Click="OnAdd" />
        <MenuItem Header="Add _Torrent…" InputGestureText="Ctrl+Shift+T" Click="OnTorrents" />
        <MenuItem Header="Add _Batch Download…" InputGestureText="Ctrl+Shift+B" Click="OnBatch" />
        <MenuItem Header="Open _Metalink File…" Click="OnMetalink" ToolTip="A .meta4 or .metalink file: each file is downloaded from all its mirrors at once and checked when done" />
        <MenuItem Header="Verify _Checksum…" InputGestureText="Ctrl+Shift+C" Click="OnChecksum" ToolTip="Calculate and compare file checksums (MD5, SHA-1, SHA-256, SHA-512)" />
        <MenuItem Header="Site _Grabber…" InputGestureText="Ctrl+Shift+G" Click="OnGrabber" />
        <MenuItem Header="_Link Grabber…" InputGestureText="Ctrl+Shift+K" Click="OnLinkGrabber" />
        <MenuItem Header="Download _Images from Page…" InputGestureText="Ctrl+Shift+I" Click="OnGallery" />
        <MenuItem Header="_Profile Batch (profile, channel or playlist)…" InputGestureText="Ctrl+Shift+L" Click="OnPlaylist" />
        <MenuItem Header="_RSS Feeds…" Click="OnFeeds" />
        <Separator />
        <MenuItem Header="_Options…" Click="OnSettings" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Downloads">
        <MenuItem Header="_Resume" InputGestureText="Ctrl+R" Click="OnResume" />
        <MenuItem Header="_Stop" InputGestureText="Ctrl+." Click="OnPause" />
        <Separator />
        <MenuItem Header="Resume _All" InputGestureText="Ctrl+Shift+R" Click="OnResumeAll" />
        <MenuItem Header="Stop A_ll" InputGestureText="Ctrl+Shift+P" Click="OnPauseAll" />
        <Separator />
        <MenuItem Header="_Open" InputGestureText="Ctrl+O" Click="OnOpen" />
        <MenuItem Header="Show in _Folder" Click="OnShowInFolder" />
        <MenuItem Header="Open _With…" Click="OnOpenWith" />
        <MenuItem Header="_Properties…" InputGestureText="Ctrl+I" Click="OnProperties" />
        <Separator />
        <MenuItem Header="_Delete…" InputGestureText="Del" Click="OnRemove" />
        <MenuItem Header="Delete _Completed…" Click="OnClear" />
        <Separator />
        <MenuItem x:Name="UnzipItem" Header="_Unpack Finished Archives (.zip, .7z, .rar, .tar)" IsCheckable="True" Click="OnToggleUnzip"
                  ToolTip="Unpack each finished .zip download into a folder next to it" />
        <MenuItem x:Name="SubtitlesItem" Header="Save Su_btitles With Videos" IsCheckable="True" Click="OnToggleSubtitles"
                  ToolTip="Videos keep subtitles in your language and English when the site has them" />
        <MenuItem Header="_Media Library…" InputGestureText="Ctrl+L" Click="OnLibrary" />
        <Separator />
        <MenuItem Header="S_cheduler…" Click="OnScheduler" />
        <MenuItem Header="Start _Queue" Click="OnStartQueue" />
        <MenuItem Header="Stop Q_ueue" Click="OnStopQueue" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="ShowToolbarItem" Header="Show _Toolbar Buttons" IsCheckable="True" Click="OnToggleToolbar" />
        <MenuItem x:Name="ShowNamesItem" Header="Show Button _Names" IsCheckable="True" Click="OnToggleNames" />
        <MenuItem x:Name="ColumnsItem" Header="_Columns" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Help" InputGestureText="F1" Click="OnHelp" />
        <MenuItem Header="Network _Diagnostics…" Click="OnDiagnostics" />
        <MenuItem Header="_Crash Reports" Click="OnCrashReports" />
        <MenuItem Header="Support the Project" Click="OnSupport" />
        <MenuItem Header="_About Nexonic Download Manager" Click="OnAbout" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Win.Panel}" BorderBrush="{DynamicResource Win.Line}" BorderThickness="0,0,0,1" Padding="6,4">
      <WrapPanel>
        <WrapPanel x:Name="Toolbar">
        <Button Style="{StaticResource ToolButton}" Click="OnAdd" ToolTip="Add one or more links (Ctrl+N)">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#2DA44E" Text="&#xE710;" /><TextBlock Style="{StaticResource Caption}" Text="Add URL" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnPlaylist" ToolTip="Profile Batch: every video of a profile, channel, playlist or page (Ctrl+Shift+L)">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#CF222E" Text="&#xE8B2;" /><TextBlock Style="{StaticResource Caption}" Text="Profile Batch" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnTorrents" ToolTip="Torrent Manager: add a .torrent file, torrent link or magnet">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#6E40C9" Text="&#xE896;" /><TextBlock Style="{StaticResource Caption}" Text="Torrents" /></StackPanel>
        </Button>
        <Border Width="1" Height="36" Background="{DynamicResource Win.Line}" Margin="6,0" VerticalAlignment="Center" />
        <Button x:Name="ResumeButton" Style="{StaticResource ToolButton}" Click="OnResume" ToolTip="Resume the selected downloads (Ctrl+R)">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#1F6FEB" Text="&#xE768;" /><TextBlock Style="{StaticResource Caption}" Text="Resume" /></StackPanel>
        </Button>
        <Button x:Name="StopButton" Style="{StaticResource ToolButton}" Click="OnPause" ToolTip="Stop the selected downloads">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#D97706" Text="&#xE769;" /><TextBlock Style="{StaticResource Caption}" Text="Stop" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnPauseAll" ToolTip="Stop every download">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#CF222E" Text="&#xE71A;" /><TextBlock Style="{StaticResource Caption}" Text="Stop All" /></StackPanel>
        </Button>
        <Border Width="1" Height="36" Background="{DynamicResource Win.Line}" Margin="6,0" VerticalAlignment="Center" />
        <Button Style="{StaticResource ToolButton}" Click="OnSelectAll" ToolTip="Select every download in this list (click again to deselect)">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#0E9F9F" Text="&#xE762;" /><TextBlock Style="{StaticResource Caption}" Text="Select All" /></StackPanel>
        </Button>
        <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Click="OnRemove" ToolTip="Remove the selected downloads from the list">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#CF222E" Text="&#xE74D;" /><TextBlock Style="{StaticResource Caption}" Text="Delete" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnClear" ToolTip="Remove finished downloads from the list">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#2DA44E" Text="&#xE73E;" /><TextBlock Style="{StaticResource Caption}" Text="Delete Completed" /></StackPanel>
        </Button>
        <Border Width="1" Height="36" Background="{DynamicResource Win.Line}" Margin="6,0" VerticalAlignment="Center" />
        <Button Style="{StaticResource ToolButton}" Click="OnScheduler" ToolTip="Queues and timetables">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#8250DF" Text="&#xE787;" /><TextBlock Style="{StaticResource Caption}" Text="Scheduler" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnStartQueue" ToolTip="Start the selected queue">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#10B981" Text="&#xE768;" /><TextBlock Style="{StaticResource Caption}" Text="Start Queue" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnStopQueue" ToolTip="Stop the selected queue">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#DB2777" Text="&#xE71A;" /><TextBlock Style="{StaticResource Caption}" Text="Stop Queue" /></StackPanel>
        </Button>
        <Border Width="1" Height="36" Background="{DynamicResource Win.Line}" Margin="6,0" VerticalAlignment="Center" />
        <Button Style="{StaticResource ToolButton}" Click="OnGrabber" ToolTip="Download files from a website section">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#1F6FEB" Text="&#xE774;" /><TextBlock Style="{StaticResource Caption}" Text="Grabber" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnBatch" ToolTip="Download a numbered series of files">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#9A6700" Text="&#xE8FD;" /><TextBlock Style="{StaticResource Caption}" Text="Batch" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnSettings" ToolTip="Options">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="{DynamicResource Win.Faint}" Text="&#xE713;" /><TextBlock Style="{StaticResource Caption}" Text="Options" /></StackPanel>
        </Button>
        </WrapPanel>
        <Border Margin="12,6,4,6" Width="220" Height="30" CornerRadius="6" BorderBrush="{DynamicResource Win.Border}" BorderThickness="1" Background="{DynamicResource Win.Panel}" VerticalAlignment="Center">
          <Grid>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Win.Faint}" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBox x:Name="Search" AutomationProperties.Name="Search downloads" BorderThickness="0" Background="Transparent" Margin="28,0,6,0" VerticalContentAlignment="Center" TextChanged="OnSearch" ToolTip="Search downloads (Ctrl+F)" />
            <TextBlock x:Name="SearchHint" Text="Search downloads" Foreground="{DynamicResource Win.Faint}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
        </Border>
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Win.Header}" BorderBrush="{DynamicResource Win.Line}" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{DynamicResource Win.Muted}" FontSize="11" />
        <TextBlock x:Name="StatusLeft" Foreground="{DynamicResource Win.Muted}" FontSize="11" />
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" MinWidth="150" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="Sidebar" AutomationProperties.Name="Categories and queues" Grid.Column="0" BorderThickness="0" Background="{DynamicResource Win.Side}" SelectionChanged="OnFilter" Padding="0,6" />
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Win.Line}" />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="Grid" AutomationProperties.Name="Downloads" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                  MouseDoubleClick="OnRowDoubleClick" SelectionChanged="OnSelection" Background="{DynamicResource Win.Panel}"
                  BorderThickness="0" RowHeight="30" CanUserReorderColumns="True" CanUserSortColumns="True"
                  HorizontalGridLinesBrush="{DynamicResource Win.GridLine}" GridLinesVisibility="Horizontal">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="OnOpen" />
              <MenuItem Header="Show in Folder" Click="OnShowInFolder" />
              <MenuItem Header="Open With…" Click="OnOpenWith" />
              <MenuItem Header="Show Progress" Click="OnShowProgress" />
              <Separator />
              <MenuItem Header="Resume" Click="OnResume" />
              <MenuItem Header="Stop" Click="OnPause" />
              <MenuItem Header="Refresh Link…" Click="OnRefreshLink" />
              <MenuItem x:Name="RecheckItem" Header="Check Torrent Files Again" Click="OnRecheck" />
              <MenuItem Header="Properties…" Click="OnProperties" />
              <MenuItem Header="Copy Link" Click="OnCopyLink" />
              <MenuItem Header="Copy as cURL" Click="OnCopyCurl" ToolTip="A command that fetches the same file elsewhere, with its cookies and login: share it with care" />
              <MenuItem Header="Check Server…" Click="OnDiagnostics" />
              <MenuItem Header="Show QR Code…" Click="OnShowQr" />
              <MenuItem Header="Verify Checksum…" Click="OnChecksum" />
              <MenuItem x:Name="MoveMenu" Header="Move to Queue" />
              <Separator />
              <MenuItem Header="Delete…" Click="OnRemove" />
              <MenuItem Header="Delete and Move File to Recycle Bin…" Click="OnRemoveFile" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="File Name" Width="*" MinWidth="230" SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon, Mode=OneWay}" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
            <DataGridTemplateColumn Header="Progress" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="10" Margin="4,0" Foreground="{StaticResource Accent}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="80" />
            <DataGridTextColumn Header="Time Left" Binding="{Binding TimeLeft}" Width="70" />
            <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="Status">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush, Mode=OneWay}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status, Mode=OneWay}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn x:Name="QueueColumn" Header="Queue" Binding="{Binding Queue}" Width="90" />
            <DataGridTextColumn x:Name="AddedColumn" Header="Added" Binding="{Binding Added}" Width="120" SortMemberPath="Record.Added" />
            <DataGridTextColumn x:Name="FinishedColumn" Header="Finished" Binding="{Binding Finished}" Width="120" SortMemberPath="Record.Finished" />
            <DataGridTextColumn x:Name="FolderColumn" Header="Folder" Binding="{Binding SaveFolder}" Width="180" />
            <DataGridTextColumn x:Name="ResumeColumn" Header="Can Resume" Binding="{Binding CanResume}" Width="85" />
            <DataGridTextColumn x:Name="PeersColumn" Header="Seeds/Peers" Binding="{Binding Peers}" Width="85" />
            <DataGridTextColumn x:Name="RatioColumn" Header="Share Ratio" Binding="{Binding Ratio}" Width="80" SortMemberPath="Record.Torrent.Ratio" />
            <DataGridTextColumn x:Name="UploadedColumn" Header="Uploaded" Binding="{Binding Uploaded}" Width="85" SortMemberPath="Record.Torrent.Uploaded" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="Empty" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="400">
          <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="52" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyTitle" Text="No downloads here yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,6" />
          <TextBlock Text="Click Add URL, paste a link, drop one on this window, or download from your browser with the extension." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Win.Muted}" />
          <Button Content="Add URL" Click="OnAdd" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="18,6" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
        <Border x:Name="Details" Grid.Row="1" Background="{DynamicResource Win.Panel}" BorderBrush="{DynamicResource Win.Line}" BorderThickness="0,1,0,0" Padding="12,8" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="DetailName" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
            <TextBox x:Name="DetailUrl" IsReadOnly="True" BorderThickness="0" Foreground="Gray" FontSize="11" Background="Transparent" />
            <local:SegmentBar x:Name="Bar" Height="14" Margin="0,6" />
            <TextBlock x:Name="DetailInfo" FontSize="11" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailError" FontSize="11" Foreground="#CF222E" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
