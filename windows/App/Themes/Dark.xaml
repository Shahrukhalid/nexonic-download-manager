<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Independent modern theme: no PaperGray styles, resources or control templates. -->
  <SolidColorBrush x:Key="ThemeCanvas" Color="#16181C"/>
  <SolidColorBrush x:Key="ThemeSurface" Color="#202329"/>
  <SolidColorBrush x:Key="ThemeElevated" Color="#2A2E36"/>
  <SolidColorBrush x:Key="ThemeBorder" Color="#3A414B"/>
  <SolidColorBrush x:Key="ThemeText" Color="#E8EBF0"/>
  <SolidColorBrush x:Key="ThemeMuted" Color="#A0A9B7"/>
  <SolidColorBrush x:Key="ThemeHover" Color="#343B46"/>
  <SolidColorBrush x:Key="ThemeSelected" Color="#364B67"/>
  <SolidColorBrush x:Key="ThemeThumb" Color="#647080"/>
  <SolidColorBrush x:Key="ThemeThumbHover" Color="#92A2B7"/>

  <Style TargetType="{x:Type Menu}">
    <Setter Property="Background" Value="{StaticResource ThemeSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="Padding" Value="5,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Menu}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,0,0,1">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="Background" Value="{StaticResource ThemeElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" Padding="4" CornerRadius="6">
            <Border.Effect>
              <DropShadowEffect Color="#000000" Opacity="0.30" BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type MenuItem}">
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Grid>
            <Border x:Name="ItemBackground" CornerRadius="4" Background="{TemplateBinding Background}" Margin="2,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="25"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="18"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="IconPresenter" Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                <Path x:Name="CheckMark" Grid.Column="0" Visibility="Collapsed" Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1.7" Data="M5,10 L9,14 L16,6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ContentPresenter x:Name="HeaderPresenter" Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource ThemeMuted}"
                           VerticalAlignment="Center" Margin="12,0,4,0"/>
                <Path x:Name="SubmenuArrow" Grid.Column="3" Fill="{TemplateBinding Foreground}"
                      Data="M0,0 L4,4 L0,8 Z" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-3"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{StaticResource ThemeElevated}" BorderBrush="{StaticResource ThemeBorder}"
                      BorderThickness="1" Padding="4" CornerRadius="6">
                <Border.Effect>
                  <DropShadowEffect Color="#000000" Opacity="0.30" BlurRadius="14" ShadowDepth="3"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
              <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
              <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="HeaderPresenter" Property="Margin" Value="4,5,9,5"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
              <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="HeaderPresenter" Property="Margin" Value="4,5,9,5"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
              <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource ThemeHover}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
              <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource ThemeSelected}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.48"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type Separator}">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="10,4"/>
    <Setter Property="Background" Value="{StaticResource ThemeBorder}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Background="{TemplateBinding Background}" Height="1"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}"
         BasedOn="{StaticResource {x:Type Separator}}"/>

  <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="ThumbBorder" Background="{StaticResource ThemeThumb}" Margin="2" CornerRadius="4"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ThemeThumbHover}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ThemeThumbHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="InvisibleScrollRepeat" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="ModernVerticalScroll" TargetType="{x:Type ScrollBar}">
    <Border Background="{StaticResource ThemeSurface}" Width="12">
      <Track x:Name="PART_Track" IsDirectionReversed="True"
             Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
             ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value}">
        <Track.Thumb><Thumb Style="{StaticResource ModernScrollThumb}"/></Track.Thumb>
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource InvisibleScrollRepeat}" Command="ScrollBar.PageUpCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource InvisibleScrollRepeat}" Command="ScrollBar.PageDownCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Border>
  </ControlTemplate>
  <ControlTemplate x:Key="ModernHorizontalScroll" TargetType="{x:Type ScrollBar}">
    <Border Background="{StaticResource ThemeSurface}" Height="12">
      <Track x:Name="PART_Track" Orientation="Horizontal"
             Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
             ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value}">
        <Track.Thumb><Thumb Style="{StaticResource ModernScrollThumb}"/></Track.Thumb>
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource InvisibleScrollRepeat}" Command="ScrollBar.PageLeftCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource InvisibleScrollRepeat}" Command="ScrollBar.PageRightCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Border>
  </ControlTemplate>
  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="{StaticResource ThemeSurface}"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template" Value="{StaticResource ModernVerticalScroll}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Template" Value="{StaticResource ModernHorizontalScroll}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="{StaticResource ThemeSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style TargetType="{x:Type ListBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="MinHeight" Value="32"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource ThemeHover}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource ThemeSelected}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="{StaticResource ThemeElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="CaretBrush" Value="{StaticResource ThemeText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
  </Style>
  <Style TargetType="{x:Type PasswordBox}">
    <Setter Property="Background" Value="{StaticResource ThemeElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="CaretBrush" Value="{StaticResource ThemeText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
  </Style>
  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="Background" Value="{StaticResource ThemeElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
  </Style>
  <Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="MinHeight" Value="28"/>
  </Style>
  <Style TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{StaticResource ThemeElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>
  <Style TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
  </Style>
  <Style TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
  </Style>
  <Style TargetType="{x:Type TabItem}">
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="Background" Value="{StaticResource ThemeSurface}"/>
  </Style>
  <Style TargetType="{x:Type Expander}">
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
  </Style>
  <Style TargetType="{x:Type GroupBox}">
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
  </Style>
  <Style TargetType="{x:Type DataGrid}">
    <Setter Property="Background" Value="{StaticResource ThemeSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="RowBackground" Value="{StaticResource ThemeSurface}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource ThemeElevated}"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ThemeBorder}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource ThemeBorder}"/>
  </Style>
  <Style TargetType="{x:Type DataGridColumnHeader}">
    <Setter Property="Background" Value="{StaticResource ThemeElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeMuted}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
  </Style>
  <Style TargetType="{x:Type DataGridRow}">
    <Setter Property="Background" Value="{StaticResource ThemeSurface}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource ThemeHover}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource ThemeSelected}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type DataGridCell}">
    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
</ResourceDictionary>