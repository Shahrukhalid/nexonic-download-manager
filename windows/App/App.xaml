<Application x:Class="Nexonic.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <!-- Main window colors; AppTheme swaps them for the dark look (Options → General → Appearance). -->
  <Application.Resources>
    <SolidColorBrush x:Key="Win.Back" Color="#F7F9FC" />
    <SolidColorBrush x:Key="Win.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Win.Side" Color="#EEF2F7" />
    <SolidColorBrush x:Key="Win.Text" Color="#1F2328" />
    <SolidColorBrush x:Key="Win.Muted" Color="#57606A" />
    <SolidColorBrush x:Key="Win.Faint" Color="#8B949E" />
    <SolidColorBrush x:Key="Win.Line" Color="#E3E8EF" />
    <SolidColorBrush x:Key="Win.GridLine" Color="#EEF1F4" />
    <SolidColorBrush x:Key="Win.Border" Color="#D0D7DE" />
    <SolidColorBrush x:Key="Win.Header" Color="#F6F8FA" />
    <SolidColorBrush x:Key="Win.Hover" Color="#EAF1FD" />
    <SolidColorBrush x:Key="Win.Pressed" Color="#D6E4FB" />
    <SolidColorBrush x:Key="Win.RowHover" Color="#F3F7FE" />
    <SolidColorBrush x:Key="Win.Selected" Color="#DCE8FC" />
  </Application.Resources>
</Application>
