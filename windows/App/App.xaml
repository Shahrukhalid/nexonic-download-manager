<Application x:Class="Nexonic.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#1F6FEB"/>
  <SolidColorBrush x:Key="WindowBrush" Color="#F7F9FC"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#EEF2F7"/>
  <SolidColorBrush x:Key="TextBrush" Color="#1F2328"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#57606A"/>
  <SolidColorBrush x:Key="BorderBrushTheme" Color="#E3E8EF"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#F3F7FE"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#DCE8FC"/>
  <Style TargetType="{x:Type Window}">
   <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style TargetType="{x:Type TextBox}">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  </Style>
  <Style TargetType="{x:Type ListBoxItem}">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style TargetType="{x:Type CheckBox}">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style TargetType="{x:Type ComboBox}">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  </Style>
 </Application.Resources>
</Application>