<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nexonic.Core</AssemblyName>
    <RootNamespace>Nexonic.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="'$(NativeTorrentLibrary)' != ''">
    <None Include="$(NativeTorrentLibrary)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Unpacks .7z, .rar and .tar archives (MIT licence). -->
    <PackageReference Include="SharpCompress" Version="0.50.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- Translations of the desktop apps (see docs/TRANSLATIONS.md). -->
    <EmbeddedResource Include="Locales\*.json" LogicalName="locale.%(Filename).json" />
  </ItemGroup>
</Project>
